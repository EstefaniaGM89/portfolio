
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import type { Lang } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = "es",
  title = "Estefanía García | Web Developer",
  description = lang === "en"
    ? "Portfolio of Estefanía García. Web development, applications, projects and digital experiences."
    : "Portfolio de Estefanía García. Desarrollo web, aplicaciones, proyectos y experiencias digitales.",
} = Astro.props;

const siteUrl = "https://estefaniagm-portfolio.vercel.app";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090f" />
    <meta name="description" content={description} />

    <link rel="icon" href="/gamer.ico" type="image/x-icon" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={`${siteUrl}/img/chibi.png`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`${siteUrl}/img/chibi.png`}
    />
  </head>

  <body class="min-h-screen overflow-x-hidden antialiased">
    <div class="site-background" aria-hidden="true"></div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <Header lang={lang} />

      <main id="main-content" class="w-full flex-1">
        <slot />
      </main>

      <Footer />
    </div>

    <script>
      import { initAOS } from "../scripts/aos-init.js";
      initAOS();
    </script>
  </body>
</html>
