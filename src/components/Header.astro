
---
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const isEnglish = lang === "en";
const prefix = isEnglish ? "/en" : "";

const navigation = [
  { name: isEnglish ? "Home" : "Inicio", path: "/" },
  { name: isEnglish ? "About me" : "Sobre mí", path: "/sobre-mi" },
  { name: isEnglish ? "Projects" : "Proyectos", path: "/proyectos" },
  { name: isEnglish ? "Education" : "Formación", path: "/certificaciones" },
  { name: isEnglish ? "Contact" : "Contacto", path: "/contacto" },
].map((item) => ({
  name: item.name,
  href: item.path === "/" ? (isEnglish ? "/en/" : "/") : `${prefix}${item.path}`,
}));

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const normalizedPath = currentPath === "/en" ? "/en/" : currentPath;

const pathWithoutLanguage = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const spanishUrl = pathWithoutLanguage;
const englishUrl = `/en${pathWithoutLanguage === "/" ? "/" : pathWithoutLanguage}`;

const availabilityText = isEnglish
  ? "Open to work"
  : "Disponible para trabajar";

const navLabel = isEnglish
  ? "Main navigation"
  : "Navegación principal";

const mobileNavLabel = isEnglish
  ? "Mobile navigation"
  : "Navegación móvil";
---

<header
  class="sticky top-0 z-[100] isolate border-b border-white/10 bg-[#09090f]/95 backdrop-blur-xl"
>
  <div
    class="relative mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-10"
  >
    <!-- LOGOTIPO -->
    <a
      href={isEnglish ? "/en/" : "/"}
      class="group relative z-10 flex shrink-0 items-center gap-2"
      aria-label={isEnglish ? "Estefanía García - Home" : "Estefanía García - Inicio"}
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl
               border border-purple-500/30 bg-purple-500/10
               font-bold text-purple-400 transition-all duration-300
               group-hover:border-purple-400 group-hover:bg-purple-500/20"
      >
        EG
      </span>

      <span class="text-lg font-bold tracking-tight text-white">
        estefania<span class="text-purple-400">.dev</span>
      </span>
    </a>

    <!-- NAVEGACIÓN DESKTOP -->
    <nav
      class="hidden items-center gap-4 md:flex lg:gap-7"
      aria-label={navLabel}
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={normalizedPath === item.href.replace(/\/$/, "") || (normalizedPath === "/" && item.href === "/") || (normalizedPath === "/en/" && item.href === "/en/") ? "page" : undefined}
            class:list={[
              "relative whitespace-nowrap text-sm font-medium transition-colors duration-300",
              normalizedPath === item.href.replace(/\/$/, "") ||
              (normalizedPath === "/" && item.href === "/") ||
              (normalizedPath === "/en/" && item.href === "/en/")
                ? "text-purple-400"
                : "text-gray-300 hover:text-white",
            ]}
          >
            {item.name}

            {(normalizedPath === item.href.replace(/\/$/, "") ||
              (normalizedPath === "/" && item.href === "/") ||
              (normalizedPath === "/en/" && item.href === "/en/")) && (
              <span
                class="absolute -bottom-2 left-0 h-0.5 w-full rounded-full bg-purple-500"
                aria-hidden="true"
              />
            )}
          </a>
        ))
      }
    </nav>

    <!-- DISPONIBILIDAD, IDIOMAS Y MENÚ -->
    <div class="relative z-10 flex shrink-0 items-center gap-3">

      <a
        href="https://www.linkedin.com/in/estefaniagm89/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full
               border border-green-500/20 bg-green-500/10
               px-4 py-2 text-xs font-medium text-green-400
               transition-colors hover:bg-green-500/20 xl:inline-flex"
      >
        <span class="h-2 w-2 rounded-full bg-green-400" aria-hidden="true"></span>
        {availabilityText}
      </a>

      <!-- SELECTOR DE IDIOMA -->
      <div
        class="flex items-center gap-1 rounded-xl border border-purple-500/25 bg-purple-500/10 p-1 text-xs font-semibold"
        aria-label={isEnglish ? "Select language" : "Seleccionar idioma"}
      >
        <a
          href={spanishUrl}
          lang="es"
          aria-current={!isEnglish ? "page" : undefined}
          class:list={[
            "rounded-lg px-2.5 py-2 transition-colors",
            !isEnglish
              ? "bg-purple-600 text-white"
              : "text-gray-400 hover:bg-white/10 hover:text-white",
          ]}
        >
          ES
        </a>

        <a
          href={englishUrl}
          lang="en"
          aria-current={isEnglish ? "page" : undefined}
          class:list={[
            "rounded-lg px-2.5 py-2 transition-colors",
            isEnglish
              ? "bg-purple-600 text-white"
              : "text-gray-400 hover:bg-white/10 hover:text-white",
          ]}
        >
          EN
        </a>
      </div>

      <!-- BOTÓN HAMBURGUESA -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label={isEnglish ? "Open menu" : "Abrir menú"}
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-open-label={isEnglish ? "Open menu" : "Abrir menú"}
        data-close-label={isEnglish ? "Close menu" : "Cerrar menú"}
        class="relative z-20 flex h-11 w-11 shrink-0
               items-center justify-center rounded-xl
               border border-white/15 bg-white/5 text-white
               transition-all duration-300
               hover:border-purple-400/50 hover:bg-purple-500/15
               focus-visible:outline focus-visible:outline-2
               focus-visible:outline-offset-2
               focus-visible:outline-purple-400
               md:hidden"
      >
        <svg
          id="menu-open-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <svg
          id="menu-close-icon"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- MENÚ MÓVIL -->
  <nav
    id="mobile-menu"
    class="relative z-10 hidden border-t border-white/10
           bg-[#101018] px-4 py-5 shadow-2xl
           sm:px-6 md:hidden"
    aria-label={mobileNavLabel}
  >
    <div class="mx-auto flex max-w-7xl flex-col gap-2">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={normalizedPath === item.href.replace(/\/$/, "") || (normalizedPath === "/" && item.href === "/") || (normalizedPath === "/en/" && item.href === "/en/") ? "page" : undefined}
            class:list={[
              "rounded-xl px-4 py-3.5 text-sm font-medium transition-all duration-200",
              normalizedPath === item.href.replace(/\/$/, "") ||
              (normalizedPath === "/" && item.href === "/") ||
              (normalizedPath === "/en/" && item.href === "/en/")
                ? "border border-purple-400/20 bg-purple-500/15 text-purple-300"
                : "border border-transparent text-gray-300 hover:bg-white/5 hover:text-white",
            ]}
          >
            {item.name}
          </a>
        ))
      }

      <a
        href="https://www.linkedin.com/in/estefaniagm89/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex items-center gap-2 rounded-xl
               border border-green-500/20 bg-green-500/10
               px-4 py-3 text-sm font-medium text-green-400
               transition-colors hover:bg-green-500/20"
      >
        <span class="h-2 w-2 rounded-full bg-green-400" aria-hidden="true"></span>
        {availabilityText}
      </a>
    </div>
  </nav>
</header>

<script>
  function setMobileMenuOpen(isOpen: boolean) {
    const menuButton = document.getElementById("mobile-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (!menuButton || !mobileMenu) return;

    mobileMenu.classList.toggle("hidden", !isOpen);
    menuButton.setAttribute("aria-expanded", String(isOpen));

    menuButton.setAttribute(
      "aria-label",
      isOpen
        ? menuButton.dataset.closeLabel || "Cerrar menú"
        : menuButton.dataset.openLabel || "Abrir menú"
    );

    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  }

  function handleHeaderClick(event: MouseEvent) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const menuButton = target.closest("#mobile-menu-toggle");

    if (menuButton) {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      setMobileMenuOpen(!isOpen);
      return;
    }

    if (target.closest("#mobile-menu a")) {
      setMobileMenuOpen(false);
    }
  }

  function initHeader() {
    const state = window as Window & {
      __portfolioHeaderInitialized?: boolean;
    };

    if (state.__portfolioHeaderInitialized) return;
    state.__portfolioHeaderInitialized = true;

    document.addEventListener("click", handleHeaderClick);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMobileMenuOpen(false);
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) setMobileMenuOpen(false);
    });
    document.addEventListener("astro:after-swap", () => {
      setMobileMenuOpen(false);
    });
  }

  initHeader();
</script>
