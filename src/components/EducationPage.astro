---
type Lang = "es" | "en";
interface Props { lang?: Lang }
const { lang = "es" } = Astro.props;
const en = lang === "en";
type Category = "academica" | "certificacion" | "cursos";
type Status = "completed" | "ongoing" | "obtained";
const credentials: {
 title: string; issuer: string; category: Category; categoryLabel: string; status: Status;
 period: string; description: string; technologies: string[]; icon: string; url?: string; urlLabel?: string;
}[] = [
 { title: en ? "Computer Engineering" : "Ingeniería Informática", issuer: "Universitat Oberta de Catalunya (UOC)", category: "academica", categoryLabel: en ? "Academic education" : "Formación académica", status: "ongoing", period: en ? "2026 — Present" : "2026 — Actualidad", description: en ? "University degree focused on developing deeper knowledge of programming, computer architecture, software engineering and computer science fundamentals." : "Grado universitario orientado a profundizar en programación, arquitectura de computadores, ingeniería del software y fundamentos de la informática.", technologies: en ? ["Software engineering", "Programming", "Computer architecture"] : ["Ingeniería del software", "Programación", "Arquitectura de computadores"], icon: "🎓" },
 { title: en ? "Higher Technician in Web Application Development" : "Técnico Superior en Desarrollo de Aplicaciones Web", issuer: "Escola Pia Mataró", category: "academica", categoryLabel: en ? "Academic education" : "Formación académica", status: "completed", period: "2025", description: en ? "Advanced vocational qualification covering frontend and backend development, object-oriented programming, relational and NoSQL databases, APIs, responsive interfaces, version control and web application deployment." : "Ciclo Formativo de Grado Superior en desarrollo frontend y backend, programación orientada a objetos, bases de datos relacionales y NoSQL, APIs, interfaces responsive, control de versiones y despliegue de aplicaciones web.", technologies: ["HTML5", "CSS3", "JavaScript", "PHP", "Java", "SQL", "MySQL", "MongoDB", "Laravel", "Git", "REST APIs", en ? "Responsive design" : "Diseño responsive", en ? "Web deployment" : "Despliegue web"], icon: "💻" },
 { title: "Decoding DevOps – From Basics to Advanced Projects with AI", issuer: "Udemy", category: "cursos", categoryLabel: en ? "Additional training" : "Formación complementaria", status: "completed", period: "2026", description: en ? "Hands-on DevOps training covering Linux systems, Bash scripting, version control, containers, CI/CD pipelines, orchestration, automation and cloud infrastructure." : "Formación práctica en DevOps: sistemas Linux, scripting Bash, control de versiones, contenedores, pipelines CI/CD, orquestación, automatización e infraestructura cloud.", technologies: ["Git", "GitLab", "Linux", "Bash", "Docker", "Vagrant", "AWS", "JSON", "YAML", "CI/CD", "Jenkins", "Kubernetes", "Ansible", "Terraform", en ? "Automation" : "Automatización"], icon: "⚙️", url: "https://www.udemy.com/course-dashboard-redirect/?course_id=4039556", urlLabel: en ? "View course" : "Ver curso" },
 { title: en ? "JavaScript Frameworks Masterclass: Angular, React, Vue" : "Máster en Frameworks JavaScript: Aprende Angular, React, Vue", issuer: "Udemy", category: "cursos", categoryLabel: en ? "Additional training" : "Formación complementaria", status: "completed", period: "2026", description: en ? "Training focused on frontend application development using the main frameworks and libraries in the JavaScript ecosystem." : "Formación centrada en el desarrollo de aplicaciones frontend mediante los principales frameworks y bibliotecas del ecosistema JavaScript.", technologies: ["JavaScript", "Angular", "React", "Vue"], icon: "🚀", url: "https://www.udemy.com/course-dashboard-redirect/?course_id=1719364", urlLabel: en ? "View course" : "Ver curso" },
];
const filters = [
 {value: "all", label: en ? "All" : "Todas"},
 {value: "academica", label: en ? "Academic education" : "Formación académica"},
 {value: "certificacion", label: en ? "Certifications" : "Certificaciones"},
 {value: "cursos", label: en ? "Courses" : "Cursos"},
];
---
<div id="certifications-page" class="relative isolate mx-auto max-w-7xl px-4 sm:px-6">
  <div aria-hidden="true" class="pointer-events-none absolute right-0 top-12 -z-10 h-[400px] w-[400px] max-w-full rounded-full bg-purple-600/10 blur-[110px]"></div>
  <div class="certifications-intro text-center" data-aos="fade-up">
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      {en ? "Education and" : "Formación y"} <span class="gradient-text">{en ? "certifications." : "certificaciones."}</span>
    </h1>
    <p class="mx-auto mt-9 max-w-2xl text-base leading-8 text-gray-400">
      {en ? "My academic and technical journey: a strong foundation in web development and continuous learning in software technologies and DevOps." : "Mi recorrido académico y técnico: una base sólida en desarrollo web y aprendizaje continuo en tecnologías de software y DevOps."}
    </p>
  </div>
  <section class="certifications-list" aria-labelledby="credentials-title">
    <h2 id="credentials-title" class="mb-8 text-center text-base font-medium text-gray-300 sm:mb-10">{en ? "My qualifications, certifications and courses" : "Mis titulaciones, acreditaciones y cursos"}</h2>
    <div class="credential-filters flex flex-wrap justify-center gap-3 sm:gap-4" id="credential-filters" role="group" aria-label={en ? "Filter education" : "Filtrar formación"}>
      {filters.map((filter) => <button type="button" data-filter={filter.value} aria-pressed={filter.value === "all" ? "true" : "false"} class:list={["filter-btn", filter.value === "all" && "is-active"]}>{filter.label}</button>)}
    </div>
    <div id="credentials-grid" class="grid items-stretch gap-8 md:grid-cols-2 lg:gap-10">
      {credentials.map((item, index) => (
        <article class="glass-card credential-card group flex h-full flex-col p-8 sm:p-10" data-category={item.category} data-aos="fade-up" data-aos-delay={Math.min(index * 80, 240)}>
          <div class="mb-9 flex items-start justify-between gap-4">
            <div aria-hidden="true" class="flex h-12 w-12 items-center justify-center rounded-2xl border border-purple-400/20 bg-purple-500/10 text-2xl">{item.icon}</div>
            <span class:list={["rounded-full border px-3 py-1 text-xs font-medium", item.status === "ongoing" ? "border-amber-400/20 bg-amber-400/10 text-amber-200" : "border-emerald-400/20 bg-emerald-400/10 text-emerald-200"]}>{item.status === "ongoing" ? (en ? "In progress" : "En curso") : item.status === "obtained" ? (en ? "Obtained" : "Obtenido") : (en ? "Completed" : "Finalizado")}</span>
          </div>
          <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.15em] text-purple-400">{item.categoryLabel}</p>
          <h3 class="mb-5 text-xl font-bold leading-snug text-white transition-colors group-hover:text-purple-300">{item.title}</h3>
          <p class="mb-3 text-sm font-medium text-purple-200">{item.issuer}</p>
          <p class="mb-7 text-xs text-gray-500">{item.period}</p>
          <p class="mb-9 text-sm leading-8 text-gray-400">{item.description}</p>
          <div class="mt-auto">
            <div class="mb-7 flex flex-wrap gap-3">{item.technologies.map((tech) => <span class="rounded-lg border border-purple-400/15 bg-purple-500/10 px-3 py-1.5 text-xs font-medium text-purple-200">{tech}</span>)}</div>
            {item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-purple-300 transition-colors hover:text-purple-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400">{item.urlLabel ?? (en ? "More information" : "Más información")} <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="certifications-cta" aria-labelledby="next-step-title" data-aos="fade-up">
    <div class="relative overflow-hidden rounded-3xl border border-purple-400/20 bg-[#171124] px-8 py-16 text-center sm:px-14 sm:py-20">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.15),transparent_65%)]"></div>
      <div class="relative z-10">
        <h2 id="next-step-title" class="mb-4 text-3xl font-bold text-white sm:text-4xl">{en ? "Learn, apply," : "Aprender, aplicar,"} <span class="gradient-text">{en ? "create." : "crear."}</span></h2>
        <p class="mx-auto mb-8 max-w-xl leading-7 text-gray-400">{en ? "Learning becomes meaningful when it turns into real projects. Explore some of the work where I have put my knowledge into practice." : "La formación cobra sentido cuando se transforma en proyectos. Descubre algunos de los trabajos en los que he aplicado mis conocimientos."}</p>
        <a href={en ? "/en/proyectos" : "/proyectos"} class="btn-primary">{en ? "View my projects" : "Ver mis proyectos"} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</div>
<script>
  function initCredentialFilters() {
    const filters = document.getElementById("credential-filters");
    const grid = document.getElementById("credentials-grid");
    if (!filters || !grid || filters.dataset.initialized === "true") return;
    filters.dataset.initialized = "true";
    filters.querySelectorAll<HTMLButtonElement>("button[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.dataset.filter;
        filters.querySelectorAll<HTMLButtonElement>("button[data-filter]").forEach((other) => {
          const active = other === button;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-pressed", String(active));
        });
        grid.querySelectorAll<HTMLElement>(".credential-card").forEach((card) => {
          card.hidden = selected !== "all" && card.dataset.category !== selected;
        });
        (window as Window & { AOS?: { refreshHard?: () => void } }).AOS?.refreshHard?.();
      });
    });
  }
  document.addEventListener("astro:page-load", initCredentialFilters);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCredentialFilters, {once: true});
  else initCredentialFilters();
</script>
