---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const featuredProjects = [
  {
    title: "Mataró Circular 2030",
    category: "Desarrollo institucional",
    description: "Proyecto web municipal sobre economía circular y sostenibilidad. Participé en la maquetación, adaptación responsive y gestión de contenidos en Plone.",
    technologies: ["HTML", "CSS", "JavaScript", "Bootstrap", "Plone"],
    image: "/img/projects/mataro-circular.png",
    link: "https://www.mataro.cat/economia-circular",
    featured: true,
  },
  {
    title: "JustType AI Keyboard",
    category: "Internship internacional",
    description: "Colaboré en el desarrollo de una app iOS con Swift y Xcode, autocorrección inteligente, traducción a más de 70 idiomas e integración de IA, además de localización y marketing digital.",
    technologies: ["Swift", "Xcode", "iOS", "IA", "ASO"],
    image: "/img/justtype.png",
    link: "https://apps.apple.com/us/app/justtype-ai-keyboard/id6590604907",
    featured: false,
  },
  {
    title: "MediTrack",
    category: "Proyecto propio · Full Stack",
    description: "Aplicación para la gestión de pacientes y tratamientos crónicos. Diseñé y desarrollé el frontend, el backend y la gestión de datos con Laravel, PHP y MySQL.",
    technologies: ["Laravel", "PHP", "MySQL", "Blade", "Tailwind CSS"],
    image: "/img/meditrack.png",
    link: "",
    featured: false,
  },
];

const skills = [
  { name: "HTML5", icon: "html5/html5-original.svg", top: "5%", left: "10%", delay: "0s" },
  { name: "CSS3", icon: "css3/css3-original.svg", top: "22%", left: "48%", delay: "2s" },
  { name: "JavaScript", icon: "javascript/javascript-original.svg", top: "40%", left: "83%", delay: "1s" },
  { name: "TypeScript", icon: "typescript/typescript-original.svg", top: "55%", left: "67%", delay: "1.5s" },
  { name: "Bootstrap", icon: "bootstrap/bootstrap-original.svg", top: "75%", left: "25%", delay: "3s" },
  { name: "Laravel", icon: "laravel/laravel-original.svg", top: "20%", left: "25%", delay: "0.5s" },
  { name: "PHP", icon: "php/php-original.svg", top: "65%", left: "45%", delay: "2s" },
  { name: "Java", icon: "java/java-original.svg", top: "75%", left: "90%", delay: "2.5s" },
  { name: "Python", icon: "python/python-original.svg", top: "30%", left: "65%", delay: "1s" },
  { name: "Swift", icon: "swift/swift-original.svg", top: "5%", left: "85%", delay: "0.8s" },
  { name: "MySQL", icon: "mysql/mysql-original.svg", top: "40%", left: "35%", delay: "2.8s" },
  { name: "Tailwind CSS", icon: "tailwindcss/tailwindcss-original.svg", top: "60%", left: "10%", delay: "1.2s" },
  { name: "Docker", icon: "docker/docker-original.svg", top: "55%", left: "55%", delay: "3.2s" },
  { name: "Figma", icon: "figma/figma-original.svg", top: "85%", left: "55%", delay: "3.8s" },
  { name: "Astro", icon: "astro/astro-original.svg", top: "65%", left: "80%", delay: "4.2s" },
  { name: "Angular", icon: "angular/angular-original.svg", top: "35%", left: "5%", delay: "2.2s" },
  { name: "React", icon: "react/react-original.svg", top: "25%", left: "75%", delay: "2.9s" },
];
---

<Layout>
  <Hero />

  <!-- HABILIDADES: burbujas originales -->
  <section id="habilidades" class="relative mx-auto w-full max-w-7xl overflow-hidden px-4 pb-16 pt-20 sm:px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <span class="inline-flex items-center justify-center rounded-full border border-purple-500/30 bg-purple-600/20 px-8 py-3 text-sm font-bold tracking-wider text-purple-300 shadow-lg shadow-purple-900/20">Skills</span>
      <p class="mt-5 text-sm text-gray-400">Tecnologías y herramientas con las que trabajo</p>
    </div>
    <div class="relative mx-auto h-[480px] w-full sm:h-[500px]">
      {skills.map((skill) => (
        <div class="floating-skill group" style={`top: ${skill.top}; left: ${skill.left}; animation-delay: ${skill.delay};`} title={skill.name} aria-label={skill.name}>
          <img src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${skill.icon}`} alt={skill.name} loading="lazy" width="64" height="64" class="pointer-events-none" />
        </div>
      ))}
    </div>
  </section>

  <!-- PROYECTOS DESTACADOS -->
  <section id="proyectos" class="relative isolate mx-auto max-w-7xl px-4 pb-24 pt-16 sm:px-6 lg:pt-24" aria-labelledby="home-projects-title">
    <div class="pointer-events-none absolute -left-20 top-32 -z-10 h-80 w-80 rounded-full bg-purple-600/10 blur-[110px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-10 bottom-20 -z-10 h-72 w-72 rounded-full bg-fuchsia-600/10 blur-[110px]" aria-hidden="true"></div>

    <div class="mx-auto mb-12 max-w-3xl text-center sm:mb-16" data-aos="fade-up">
      <p class="mb-4 font-mono text-xs tracking-[0.3em] text-purple-400">SELECTED WORK / 03</p>
      <h2 id="home-projects-title" class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">Proyectos que <span class="gradient-text">cobran vida.</span></h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-gray-400">Del desarrollo institucional a las aplicaciones inteligentes. Una selección de trabajos donde combino tecnología, diseño y soluciones reales.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
      {featuredProjects.map((project, index) => (
        <article class:list={["home-project-card group flex min-w-0 flex-col overflow-hidden rounded-3xl border border-purple-400/15 bg-[#15101f]/90", project.featured && "lg:col-span-2 lg:grid lg:grid-cols-[1.18fr_1fr]"]} data-aos="fade-up" data-aos-delay={Math.min(index * 100, 200)}>
          <div class:list={["relative min-h-0 overflow-hidden bg-[#1b1428]", project.featured ? "aspect-[16/10] lg:aspect-auto lg:min-h-[330px]" : "aspect-[16/10]"]}>
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(139,92,246,.25),transparent_60%)]" aria-hidden="true"></div>
            {project.link ? (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class:list={["relative flex h-full w-full items-center justify-center p-5 sm:p-8", project.featured && "lg:p-12"]} aria-label={`Abrir ${project.title} en una nueva pestaña`}>
                <img src={project.image} alt={`Captura del proyecto ${project.title}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" class:list={["block max-h-full max-w-full object-contain transition-transform duration-700", project.featured ? "h-auto w-auto max-h-[245px] sm:max-h-[300px] lg:max-h-[310px] group-hover:scale-[1.015]" : "h-full w-full group-hover:scale-[1.045]"]} />
              </a>
            ) : (
              <div class="relative h-full w-full p-4 sm:p-6"><img src={project.image} alt={`Captura del proyecto ${project.title}`} loading="lazy" decoding="async" class:list={["block max-h-full max-w-full object-contain transition-transform duration-700", project.featured ? "h-auto w-auto max-h-[245px] sm:max-h-[300px] lg:max-h-[310px] group-hover:scale-[1.015]" : "h-full w-full group-hover:scale-[1.045]"]} /></div>
            )}
          </div>
          <div class:list={["flex flex-1 flex-col p-6 sm:p-8", project.featured && "lg:justify-center lg:p-10"]}>
            <div class="mb-5"><span class="inline-flex max-w-full rounded-full border border-purple-400/25 bg-purple-500/10 px-3.5 py-1.5 text-xs font-semibold text-purple-200">{project.category}</span></div>
            <h3 class:list={["mb-4 font-bold leading-tight text-white transition-colors duration-300 group-hover:text-purple-300", project.featured ? "text-2xl sm:text-3xl" : "text-2xl"]}>{project.title}</h3>
            <p class="mb-6 text-sm leading-7 text-gray-400">{project.description}</p>
            <div class="mb-7 flex flex-wrap gap-2">
              {project.technologies.map((tech) => <span class="rounded-lg border border-purple-400/15 bg-purple-500/10 px-2.5 py-1.5 text-xs font-medium text-purple-200">{tech}</span>)}
            </div>
            <div class="mt-auto border-t border-white/10 pt-5">
              {project.link ? (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-purple-300 transition-all duration-300 hover:gap-3 hover:text-purple-200">Ver proyecto <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="text-sm text-gray-500">Proyecto académico · Demo no publicada</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center" data-aos="fade-up">
      <a href="/proyectos" class="home-projects-link inline-flex items-center justify-center gap-3 rounded-full border border-purple-400/40 bg-purple-500/15 px-8 py-4 text-sm font-semibold text-purple-100 transition-all duration-300 hover:border-purple-300 hover:bg-purple-500/25 hover:shadow-[0_0_35px_rgba(139,92,246,.2)]">
        Explorar todos los proyectos <span aria-hidden="true">↗</span>
      </a>
      <p class="mt-4 text-xs text-gray-500">Más trabajos institucionales, profesionales y personales</p>
    </div>
  </section>

  <!-- SOBRE MÍ -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
      <h2 class="mb-6 text-3xl font-bold text-white">¿Quién soy?</h2>
      <p class="text-lg leading-8 text-gray-300">Soy una desarrolladora apasionada por crear soluciones prácticas y visualmente atractivas. Me encanta unir la lógica del backend con la estética del frontend, y estoy en constante aprendizaje para seguir mejorando día a día.</p>
    </div>
  </section>
</Layout>

